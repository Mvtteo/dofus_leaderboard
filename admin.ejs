                            <div class="form-group">
                                <label class="form-label">Modifier la date de fin</label>
                                <input type="date" id="seasonEndInput" class="form-input" value="<%= curSeason ? curSeason.endRaw : '' %>" />
                            </div>
                            <button class="btn btn-primary" onclick="updateSeasonEnd()">Appliquer</button>
                            <button class="btn btn-danger btn-sm" onclick="resetSeasonEnd()" title="Remettre la date par defaut" style="padding:0.75rem;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card card-full">
                    <div class="card-title">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 3h12l4 6-10 13L2 9z"/>
                        </svg>
                        Classement Pepites
                        <span id="nuggetsTotal" style="margin-left:auto;font-size:0.8rem;color:var(--gold);font-weight:600;text-shadow:0 0 12px var(--gold-glow);">
                            <% if (nuggets.length > 0) { %>
                                Total : <%= nuggets.reduce((s, n) => s + (parseInt(n.nuggets) || 0), 0).toLocaleString() %>
                            <% } %>
                        </span>
                    </div>

                    <div class="nuggets-header">
                        <div class="nuggets-header-left">
                            <select class="form-select" id="nuggetsSeason" onchange="loadNuggets(this.value)">
                                <% seasons.forEach(s => { %>
                                    <option value="<%= s.id %>" <%= s.id === currentSeason ? 'selected' : '' %>><%= s.label %></option>
                                <% }); %>
                            </select>
                        </div>
                        <button class="btn btn-danger btn-sm" onclick="confirmResetNuggets()">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            Reset pepites (saison en cours)
                        </button>
                    </div>

                    <div id="nuggetsTableContainer">
                        <% if (nuggets.length === 0) { %>
                            <div class="empty-state">Aucune pepite pour cette saison.</div>
                        <% } else { %>
                            <table class="nuggets-table">
                                <thead><tr><th>#</th><th>Joueur</th><th style="text-align:right;">Pepites</th></tr></thead>
                                <tbody>
                                    <% nuggets.forEach((n, i) => { %>
