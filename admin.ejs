                        <div class="empty-state">Chargement...</div>
                    </div>
                </div>

                <!-- HISTORIQUE JOUEUR -->
                <div class="card card-full" id="playerMatchesCard" style="display:none;">
                    <div class="card-title">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                        </svg>
                        Historique — <span id="playerMatchesName" style="color:var(--accent-bright);"></span>
                    </div>
                    <div id="playerMatchesContainer"><div class="empty-state">Aucun match.</div></div>
                    <div class="pagination" id="playerMatchesPagination"></div>
                </div>

                <!-- DERNIERS MATCHS GLOBAUX -->
                <div class="card card-full">
                    <div class="card-title">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Derniers matchs
                        <button class="btn btn-sm" onclick="loadRecentMatches(recentPage)" style="margin-left:auto;background:rgba(42,157,143,0.1);color:var(--accent-bright);border:1px solid var(--border-medium);">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                            Actualiser
                        </button>
                    </div>
                    <div id="recentMatchesContainer"><div class="empty-state">Chargement...</div></div>
                    <div class="pagination" id="recentMatchesPagination"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONFIRM DIALOG -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-box">
            <p id="confirmMsg">Confirmer ?</p>
            <div class="confirm-actions">
                <button class="btn btn-danger" id="confirmYes">Confirmer</button>
                <button class="btn btn-sm" onclick="closeConfirm()" style="background:var(--bg-input);color:var(--text-secondary);border:1px solid var(--border-subtle);">Annuler</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        // ===== TABS =====
        function switchTab(e, name) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + name).classList.add('active');
            e.currentTarget.classList.add('active');
            if (name === 'joueurs') {
                loadMultiAccounts();
                loadRecentMatches(1);
            }
        }

        // ===== TOAST =====
        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = `toast ${type} show`;
            setTimeout(() => t.classList.remove('show'), 3500);
        }

        function escapeHTML(str) {
            const d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }

        // ===== CONFIRM =====
        let confirmCallback = null;
        function openConfirm(msg, cb) {
            document.getElementById('confirmMsg').textContent = msg;
            confirmCallback = cb;
            document.getElementById('confirmOverlay').classList.add('show');
        }
        function closeConfirm() { document.getElementById('confirmOverlay').classList.remove('show'); confirmCallback = null; }
        document.getElementById('confirmYes').addEventListener('click', () => {
            if (confirmCallback) confirmCallback();
            closeConfirm();
        });

        // ===== SAISON =====
        async function updateSeasonEnd() {
            const val = document.getElementById('seasonEndInput').value;
            if (!val) return showToast('Saisissez une date.', 'error');
            try {
                const res = await fetch('/admin/api/season-end', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ end_date: val })
                });
                const data = await res.json();
                if (data.ok) {
                    showToast('Date de fin mise a jour.');
                    if (data.curSeason) document.getElementById('seasonEnd').textContent = new Date(data.curSeason.end).toLocaleDateString('fr-FR');
                } else showToast(data.error || 'Erreur.', 'error');
            } catch { showToast('Erreur reseau.', 'error'); }
        }

        async function resetSeasonEnd() {
            try {
                const res = await fetch('/admin/api/season-end', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ end_date: '' })
                });
                const data = await res.json();
                if (data.ok) { showToast('Date remise par defaut.'); setTimeout(() => location.reload(), 500); }
            } catch { showToast('Erreur reseau.', 'error'); }
        }

        // ===== POOLS =====
        const MAX_POOLS = <%= maxPools %>;
        let poolCounter = <%= pools.length %>;

        function addPool() {
            const container = document.getElementById('poolContainer');
            const rows = container.querySelectorAll('.pool-row');
            if (rows.length >= MAX_POOLS) return;
            poolCounter++;
            const id = 'pool_' + poolCounter;
            const div = document.createElement('div');
            div.className = 'pool-row pool-grid';
            div.style.cssText = 'grid-template-columns:1fr 100px 40px;margin-bottom:0.5rem;';
            div.dataset.poolId = id;
            div.innerHTML = `
                <div style="display:flex;align-items:center;gap:0.5rem;">
                    <div class="pool-dot" style="flex-shrink:0;"></div>
                    <input type="text" class="form-input pool-name-input" value="" placeholder="Nom de la pool" />
                </div>
                <div style="position:relative;">
                    <input type="number" class="form-input form-input-small pool-bonus-input" value="0" style="width:100%;padding-right:1.5rem;" />
                    <span style="position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:0.75rem;pointer-events:none;">%</span>
                </div>
                <button type="button" class="btn btn-danger btn-sm" onclick="removePool(this)" style="padding:0.35rem 0.5rem;min-width:0;" title="Supprimer">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>`;
            container.appendChild(div);
            updatePoolCount();
        }

        function removePool(btn) {
            const row = btn.closest('.pool-row');
            const rows = document.querySelectorAll('.pool-row');
            if (rows.length <= 1) return showToast('Il faut au moins 1 pool.', 'error');
            row.remove();
            updatePoolCount();
        }

        function updatePoolCount() {
            const count = document.querySelectorAll('.pool-row').length;
            document.getElementById('poolCount').textContent = count + '/' + MAX_POOLS;
            const addBtn = document.getElementById('addPoolBtn');
            if (count >= MAX_POOLS) { addBtn.style.opacity = '0.4'; addBtn.style.pointerEvents = 'none'; }
            else { addBtn.style.opacity = '1'; addBtn.style.pointerEvents = 'auto'; }
        }

        async function savePools() {
            const rows = document.querySelectorAll('.pool-row');
            const pools = [];
            for (const row of rows) {
                const name = row.querySelector('.pool-name-input').value.trim();
                const bonus = parseInt(row.querySelector('.pool-bonus-input').value) || 0;
                const id = row.dataset.poolId;
                if (!name) { showToast('Un nom de pool est vide.', 'error'); return; }
                pools.push({ id, name, bonus });
            }
            try {
                const res = await fetch('/admin/api/pools', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pools }) });
                const data = await res.json();
                if (data.ok) showToast('Pools sauvegardees.');
                else showToast(data.error || 'Erreur.', 'error');
            } catch { showToast('Erreur reseau.', 'error'); }
        }

        // ===== AUTOCOMPLETE =====
        let allPlayerNames = [];
        (async () => { try { const r = await fetch('/admin/api/players'); allPlayerNames = await r.json(); } catch {} })();

        let ptsCurrent = 0;
        let ptsDelta = 0;

        const searchInput = document.getElementById('playerSearch');
        const acList = document.getElementById('autocompleteList');
        const ptsEditor = document.getElementById('pointsEditor');
        const ptsCurrentEl = document.getElementById('ptsCurrentDisplay');
        const ptsDeltaEl = document.getElementById('ptsDeltaDisplay');
        const ptsPreviewEl = document.getElementById('ptsPreviewDisplay');
        const ptsHidden = document.getElementById('ptsHiddenInput');
        const ptsSubmitBtn = document.getElementById('ptsSubmitBtn');

        searchInput.addEventListener('input', () => {
            const val = searchInput.value.toLowerCase();
            if (val.length < 1) { acList.classList.remove('show'); return; }
            const matches = allPlayerNames.filter(n => n.toLowerCase().includes(val)).slice(0, 10);
            if (matches.length === 0) { acList.classList.remove('show'); return; }
            acList.innerHTML = matches.map(m => {
                const d = document.createElement('div'); d.textContent = m;
                return `<div class="autocomplete-item">${d.innerHTML}</div>`;
            }).join('');
            acList.classList.add('show');
            acList.querySelectorAll('.autocomplete-item').forEach(item => {
                item.addEventListener('click', () => {
                    searchInput.value = item.textContent;
                    acList.classList.remove('show');
                    loadPlayerPoints(item.textContent);
                });
            });
        });
        document.addEventListener('click', (e) => { if (!e.target.closest('.autocomplete-wrapper')) acList.classList.remove('show'); });

        // ===== HISTORIQUE JOUEUR =====
        let playerMatchesData = [];
        let playerMatchesPage = 1;
        let currentPlayerPseudo = '';
        const PAGE_SIZE = 5;

        async function loadPlayerPoints(pseudo) {
            currentPlayerPseudo = pseudo;
            try {
                const res = await fetch(`/admin/api/player-stats/${encodeURIComponent(pseudo)}`);
                const data = await res.json();
                ptsCurrent = data.points || 0;
                ptsDelta = 0;
                updatePtsDisplay();
                ptsEditor.style.display = 'block';
            } catch { ptsCurrent = 0; ptsDelta = 0; updatePtsDisplay(); ptsEditor.style.display = 'block'; }
            await loadPlayerMatches(pseudo);
        }

        async function loadPlayerMatches(pseudo) {
            const card = document.getElementById('playerMatchesCard');
            const container = document.getElementById('playerMatchesContainer');
            const nameEl = document.getElementById('playerMatchesName');
            nameEl.textContent = pseudo;
            card.style.display = 'block';
            container.innerHTML = '<div class="empty-state">Chargement...</div>';
            try {
                const res = await fetch(`/admin/api/player-matches/${encodeURIComponent(pseudo)}`);
                playerMatchesData = await res.json();
                playerMatchesPage = 1;
                renderPlayerMatches();
            } catch { container.innerHTML = '<div class="empty-state">Erreur chargement.</div>'; }
        }

        function renderPlayerMatches() {
            const container = document.getElementById('playerMatchesContainer');
            const pagEl = document.getElementById('playerMatchesPagination');
            const total = playerMatchesData.length;
            if (total === 0) { container.innerHTML = '<div class="empty-state">Aucun match.</div>'; pagEl.innerHTML = ''; return; }
            const totalPages = Math.ceil(total / PAGE_SIZE);
            const start = (playerMatchesPage - 1) * PAGE_SIZE;
            const rows = playerMatchesData.slice(start, start + PAGE_SIZE);
            container.innerHTML = renderMatchTable(rows, 'player');
            pagEl.innerHTML = renderPagination(playerMatchesPage, totalPages, 'playerMatchesPage');
        }

        // ===== DERNIERS MATCHS GLOBAUX =====
        let recentMatchesData = [];
        let recentPage = 1;

        async function loadRecentMatches(page = 1) {
            recentPage = page;
            const container = document.getElementById('recentMatchesContainer');
            if (recentMatchesData.length === 0) container.innerHTML = '<div class="empty-state">Chargement...</div>';
            try {
                const res = await fetch('/admin/api/recent-matches');
                recentMatchesData = await res.json();
                renderRecentMatches();
            } catch { container.innerHTML = '<div class="empty-state">Erreur chargement.</div>'; }
        }

        function renderRecentMatches() {
            const container = document.getElementById('recentMatchesContainer');
            const pagEl = document.getElementById('recentMatchesPagination');
            const total = recentMatchesData.length;
            if (total === 0) { container.innerHTML = '<div class="empty-state">Aucun match.</div>'; pagEl.innerHTML = ''; return; }
            const totalPages = Math.ceil(total / PAGE_SIZE);
            const start = (recentPage - 1) * PAGE_SIZE;
            const rows = recentMatchesData.slice(start, start + PAGE_SIZE);
            container.innerHTML = renderMatchTable(rows, 'recent');
            pagEl.innerHTML = renderPagination(recentPage, totalPages, 'recentPage');
        }

        function renderMatchTable(rows, ctx) {
            let html = `<table class="match-table">
                <thead><tr>
                    <th>Date</th><th>Résultat</th><th>Contexte</th><th>Alliance</th><th>Joueurs</th>
                    <th style="text-align:center;">Points</th><th style="text-align:center;">Actions</th>
                </tr></thead><tbody>`;
            for (const m of rows) {
                const isWin = m.has_won;
                const cancelled = m.cancelled;
                const date = m.created_at ? new Date(m.created_at).toLocaleString('fr-FR', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '—';
                const rowClass = cancelled ? ' class="match-cancelled"' : '';
                html += `<tr${rowClass}>
                    <td style="color:var(--text-muted);font-size:0.75rem;">${date}</td>
                    <td class="${isWin ? 'match-win' : 'match-lose'}">${isWin ? 'Victoire' : 'Défaite'}</td>
                    <td style="color:var(--text-muted);">${m.context === 'attack' ? 'Attaque' : 'Défense'}</td>
                    <td>${escapeHTML(m.alliance || '—')}</td>
                    <td style="font-size:0.75rem;color:var(--text-muted);">${(m.winners||[]).concat(m.losers||[]).map(p=>escapeHTML(p)).join(', ')}</td>
                    <td style="text-align:center;">
                        ${cancelled ? '<span style="color:var(--text-muted);">annulé</span>' :
                        `<input type="number" class="pts-input-inline" value="${m.points_awarded}" id="pts_${m.id}" />`}
                    </td>
                    <td style="text-align:center;white-space:nowrap;">
                        ${cancelled ? '' : `
                        <button class="btn-action btn-edit" onclick="editMatchPoints(${m.id}, '${ctx}')">Modifier</button>
                        <button class="btn-action btn-cancel" onclick="cancelMatch(${m.id}, '${ctx}')" style="margin-left:0.3rem;">Annuler</button>
                        `}
                    </td>
                </tr>`;
            }
            html += '</tbody></table>';
            return html;
        }

        function renderPagination(current, total, varName) {
            if (total <= 1) return '';
            let html = '';
            for (let i = 1; i <= total; i++) {
                const active = i === current ? ' active' : '';
                html += `<button class="page-btn${active}" onclick="${varName}=${i};${varName==='playerMatchesPage'?'renderPlayerMatches()':'renderRecentMatches()}">${i}</button>`;
            }
            return html;
        }

        async function editMatchPoints(matchId, ctx) {
            const input = document.getElementById(`pts_${matchId}`);
            const newPts = parseInt(input?.value);
            if (isNaN(newPts)) return showToast('Points invalides.', 'error');
            try {
                const res = await fetch(`/admin/api/match/${matchId}/points`, {
                    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ points: newPts })
                });
                const data = await res.json();
                if (data.ok) {
                    showToast(`Match #${matchId} mis à jour.`);
                    if (ctx === 'player') await loadPlayerMatches(currentPlayerPseudo);
                    else { recentMatchesData = []; await loadRecentMatches(recentPage); }
                } else showToast(data.error || 'Erreur.', 'error');
            } catch { showToast('Erreur reseau.', 'error'); }
        }

        async function cancelMatch(matchId, ctx) {
            openConfirm(`Annuler le match #${matchId} ? Les points seront retirés aux joueurs.`, async () => {
                try {
                    const res = await fetch(`/admin/api/match/${matchId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.ok) {
                        showToast(`Match #${matchId} annulé.`);
                        if (ctx === 'player') await loadPlayerMatches(currentPlayerPseudo);
                        else { recentMatchesData = []; await loadRecentMatches(recentPage); }
                        if (ctx === 'player') { ptsCurrent = data.newTotal ?? ptsCurrent; ptsDelta = 0; updatePtsDisplay(); }
                    } else showToast(data.error || 'Erreur.', 'error');
                } catch { showToast('Erreur reseau.', 'error'); }
            });
        }

        // ===== MULTI COMPTES =====
            ptsCurrentEl.textContent = ptsCurrent;
            ptsDeltaEl.textContent = ptsDelta === 0 ? '0' : (ptsDelta > 0 ? '+' + ptsDelta : ptsDelta);
            ptsDeltaEl.className = 'pts-delta' + (ptsDelta > 0 ? ' positive' : ptsDelta < 0 ? ' negative' : '');
            const preview = ptsCurrent + ptsDelta;
            ptsPreviewEl.textContent = preview;
            ptsPreviewEl.style.color = ptsDelta > 0 ? 'var(--accent-bright)' : ptsDelta < 0 ? 'var(--red)' : 'var(--text-secondary)';
            ptsHidden.value = ptsDelta;
            ptsSubmitBtn.disabled = ptsDelta === 0;
        }

        document.getElementById('pointsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const fd = new FormData(e.target);
            const body = Object.fromEntries(fd.entries());
            if (parseInt(body.points) === 0) return;
            try {
                const res = await fetch('/admin/api/player-points', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                const data = await res.json();
                if (data.ok) {
                    showToast(`${data.pseudo} : ${data.newTotal} pts (${data.delta >= 0 ? '+' : ''}${data.delta})`);
                    ptsCurrent = data.newTotal;
                    ptsDelta = 0;
                    updatePtsDisplay();
                } else showToast(data.error || 'Erreur.', 'error');
            } catch { showToast('Erreur reseau.', 'error'); }
        });

        // ===== GRILLES =====
        async function saveGrids() {
            const readGrid = (name) => {
                const grid = [];
                for (let r = 0; r < 5; r++) {
                    const row = [];
                    for (let c = 0; c < 5; c++) {
                        const input = document.querySelector(`input[data-grid="${name}"][data-r="${r}"][data-c="${c}"]`);
                        row.push(parseInt(input.value) || 0);
                    }
                    grid.push(row);
                }
                return grid;
            };
            try {
                const res = await fetch('/admin/api/points-grid', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        pts_atk_win: readGrid('atk_win'), pts_atk_lose: readGrid('atk_lose'),
                        pts_def_win: readGrid('def_win'), pts_def_lose: readGrid('def_lose')
                    })
                });
                const data = await res.json();
                if (data.ok) showToast('Bareme sauvegarde.');
                else showToast(data.error || 'Erreur.', 'error');
            } catch { showToast('Erreur reseau.', 'error'); }
        }

        // ===== MULTI COMPTES =====
        let multiLoaded = false;
        async function loadMultiAccounts() {
            if (multiLoaded) return;
            const container = document.getElementById('multiTableContainer');
            const countEl = document.getElementById('multiCount');
            try {
                const res = await fetch('/admin/api/multi-accounts');
                const rows = await res.json();
                multiLoaded = true;
                if (rows.length === 0) {
                    container.innerHTML = '<div class="empty-state">Aucun compte multiple detecte.</div>';
                    countEl.textContent = '0 groupes';
                    return;
                }
                countEl.textContent = rows.length + ' groupe' + (rows.length > 1 ? 's' : '');
                let html = '<table class="multi-table"><thead><tr><th>#</th><th>Pseudos lies</th><th style="text-align:center;">Comptes</th></tr></thead><tbody>';
                rows.forEach((r, i) => {
                    const tags = r.pseudos.map(p => `<span class="multi-tag">${escapeHTML(p)}</span>`).join('');
                    html += `<tr><td style="color:var(--text-muted);font-size:0.8rem;">${i+1}</td><td>${tags}</td><td style="text-align:center;"><span class="multi-count">${r.count}</span></td></tr>`;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            } catch {
                container.innerHTML = '<div class="empty-state">Erreur chargement.</div>';
            }
        }

        // ===== NUGGETS =====
        async function loadNuggets(seasonId) {
            const container = document.getElementById('nuggetsTableContainer');
            const totalSpan = document.getElementById('nuggetsTotal');
            try {
                const res = await fetch(`/admin/api/nuggets/${seasonId}`);
                const rows = await res.json();
                if (rows.length === 0) {
                    container.innerHTML = '<div class="empty-state">Aucune pepite pour cette saison.</div>';
                    totalSpan.textContent = '';
                    return;
                }
                const total = rows.reduce((s, r) => s + parseInt(r.nuggets), 0);
                totalSpan.textContent = `Total : ${total.toLocaleString()}`;
                let html = '<table class="nuggets-table"><thead><tr><th>#</th><th>Joueur</th><th style="text-align:right;">Pepites</th></tr></thead><tbody>';
                rows.forEach((r, i) => {
                    const rankClass = i < 3 ? ` nuggets-rank-${i+1}` : '';
                    const amountClass = i === 0 ? ' nuggets-amount-gold' : '';
                    html += `<tr><td class="nuggets-rank${rankClass}">${i+1}</td><td class="nuggets-name">${escapeHTML(r.name)}</td><td class="nuggets-amount${amountClass}">${parseInt(r.nuggets).toLocaleString()}</td></tr>`;
                });
                html += `<tr class="nuggets-total-row"><td></td><td>Total alliance</td><td style="text-align:right;">${total.toLocaleString()}</td></tr>`;
                html += '</tbody></table>';
                container.innerHTML = html;
            } catch { container.innerHTML = '<div class="empty-state">Erreur chargement.</div>'; }
        }

        function confirmResetNuggets() {
            openConfirm('Remettre toutes les pepites a zero pour la saison en cours ?', async () => {
                try {
                    const res = await fetch('/admin/api/reset-nuggets', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                    const data = await res.json();
                    if (data.ok) {
                        showToast(`Pepites remises a zero (saison ${data.seasonId}).`);
                        document.getElementById('nuggetsSeason').value = data.seasonId;
                        loadNuggets(data.seasonId);
                    } else showToast(data.error || 'Erreur.', 'error');
                } catch { showToast('Erreur reseau.', 'error'); }
            });
        }
    </script>
    <% } %>
</body>
</html>
