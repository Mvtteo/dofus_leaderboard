                                        <% } %>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div>
                            <div style="font-size:0.75rem;font-weight:700;color:var(--red);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.75rem;">Defaite</div>
                            <table class="grid-table">
                                <thead><tr><th class="grid-corner">Ogre \ Adv</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th></tr></thead>
                                <tbody>
                                    <% for (let r = 0; r < 5; r++) { %>
