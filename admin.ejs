                            <table class="grid-table">
                                <thead><tr><th class="grid-corner">Ogre \ Adv</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th></tr></thead>
                                <tbody>
                                    <% for (let r = 0; r < 5; r++) { %>
                                    <tr><td class="grid-row-header"><%= r + 1 %></td>
                                        <% for (let c = 0; c < 5; c++) { %>
                                        <td><input type="number" class="grid-input" data-grid="def_lose" data-r="<%= r %>" data-c="<%= c %>" value="<%= ptsDefLose[r][c] %>" /></td>
                                        <% } %>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div style="margin-top:1.25rem;text-align:right;">
                        <button class="btn btn-primary" onclick="saveGrids()">Sauvegarder le bareme</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== TAB 3 : JOUEURS ===== -->
        <div class="tab-panel" id="tab-joueurs">
            <div class="dash-grid">
                <!-- AJUSTEMENT POINTS -->
                <div class="card">
                    <div class="card-title">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Ajustement points
                    </div>
                    <form id="pointsForm">
                        <div class="form-group autocomplete-wrapper" style="margin-bottom:1.25rem;">
                            <label class="form-label">Joueur</label>
                            <input type="text" id="playerSearch" name="pseudo" class="form-input" placeholder="Rechercher un joueur..." autocomplete="off" required />
                            <div class="autocomplete-list" id="autocompleteList"></div>
                        </div>

                        <div id="pointsEditor" style="display:none;">
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
                                <span style="font-size:0.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;">Actuel :</span>
                                <span id="ptsCurrentDisplay" style="font-size:1rem;font-weight:700;color:var(--text-secondary);font-variant-numeric:tabular-nums;">-</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                <button type="button" class="btn-pts" onclick="adjustPts(-5)">-5</button>
                                <button type="button" class="btn-pts" onclick="adjustPts(-1)">-1</button>
                                <div id="ptsDeltaDisplay" class="pts-delta">0</div>
                                <button type="button" class="btn-pts btn-pts-plus" onclick="adjustPts(+1)">+1</button>
                                <button type="button" class="btn-pts btn-pts-plus" onclick="adjustPts(+5)">+5</button>
                                <div style="flex:1;"></div>
                                <button type="button" class="btn-pts-reset" onclick="resetPts()">Reset</button>
                            </div>
