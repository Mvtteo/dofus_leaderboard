<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ogre</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/png" href="web/assets/logo_ogre.png">
    <style>
        /* Winrate Styles */
        .col-winrate {
            width: 180px;
            text-align: center;
        }
        .cell-winrate {
            padding: 0.5rem;
        }
        .winrate-container {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .winrate-bar {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            overflow: hidden;
        }
        .winrate-fill {
            height: 100%;
            background: linear-gradient(90deg, #e76f51, #e9c46a, #2a9d8f);
            border-radius: 3px;
            transition: width 0.5s ease;
        }
        .winrate-value {
            font-weight: 600;
            font-size: 0.875rem;
            min-width: 40px;
            text-align: right;
        }
        .winrate-value.positive {
            color: #2a9d8f;
        }
        .winrate-value.negative {
            color: #e76f51;
        }
        .winrate-detail {
            display: block;
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 2px;
        }
        /* Rank Change Arrows */
        .rank-change {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 6px;
            vertical-align: middle;
        }
        .rank-change.up {
            color: #2a9d8f;
        }
        .rank-change.down {
            color: #e76f51;
        }
        .rank-change.same {
            color: rgba(255, 255, 255, 0.25);
        }
        .rank-change svg {
            width: 12px;
            height: 12px;
        }
    </style>
</head>
<body>
    <!-- Animated Background - Dofus Theme -->
    <div class="bg-container">
        <div class="bg-gradient"></div>
        <div class="bg-grid"></div>
        
        <!-- Runes flottantes -->
        <div class="floating-runes">
            <div class="rune rune-1">&#x2726;</div>
            <div class="rune rune-2">&#x2727;</div>
            <div class="rune rune-3">&#x2728;</div>
            <div class="rune rune-4">&#x2726;</div>
            <div class="rune rune-5">&#x2729;</div>
            <div class="rune rune-6">&#x2727;</div>
        </div>
        
        <!-- Particules d'energie -->
        <div class="energy-particles" id="particles"></div>
        
        <!-- Brume magique -->
        <div class="magic-mist"></div>
    </div>

    <!-- Header Compact -->
    <header class="header">
        <div class="header-inner">
            <!-- Logo + Title -->
            <div class="header-brand">
                <div class="logo">
                    <img src="/web/assets/logo_ogre.png" alt="Logo" />
                </div>
                <div class="brand-text">
                    <h1 class="brand-title">OGRE</h1>
                    <span class="brand-sub">PVP TRACKER</span>
                </div>
            </div>

            <!-- Stats -->
            <div class="header-stats">
                <div class="stat-item">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value" id="playerCount"><%= players.length %></span>
                        <span class="stat-label">Joueurs</span>
                    </div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <div class="stat-icon gold">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14.5 17.5L3 6V3h3l11.5 11.5"/>
                            <path d="M13 19l6-6"/>
                            <path d="M16 16l4 4"/>
                            <path d="M19 21l2-2"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value" id="totalCombats"><%= locals.totalCombats || 0 %></span>
                        <span class="stat-label">Combats</span>
                    </div>
                </div>
            </div>

            <!-- Search + Season -->
            <div class="header-actions">
                <div class="search-container" id="searchContainer">
                    <button class="search-toggle" id="searchToggle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                    <input type="text" id="searchInput" placeholder="Rechercher..." />
                </div>
                <div class="season-selector">
                    <select class="season-dropdown" id="seasonSelect">
                        <% [...seasons].reverse().forEach(function(season) { %>
                            <option value="<%= season.id %>" <%= season.id === currentSeason ? 'selected' : '' %>>
                                <%= season.label %>
                            </option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Podium Horizontal -->
        <section class="podium-section">
            <% if (players.length >= 3) { %>
            <div class="podium-container">
                <!-- 2nd Place - Left -->
                <div class="podium-item silver" data-rank="2">
                    <div class="podium-avatar">
                        <span><%= players[1].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <div class="podium-info">
                        <div class="podium-name"><%= players[1].dofus_pseudo %></div>
                        <div class="podium-score"><%= players[1].total_points.toLocaleString() %></div>
                    </div>
                    <div class="podium-pedestal">
                        <div class="pedestal-front"></div>
                        <div class="pedestal-top"></div>
                    </div>
                </div>

                <!-- 1st Place - Center -->
                <div class="podium-item gold" data-rank="1">
                    <div class="crown-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5z"/>
                            <path d="M19 19H5v2h14v-2z"/>
                        </svg>
                    </div>
                    <div class="podium-avatar">
                        <span><%= players[0].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <div class="podium-info">
                        <div class="podium-name"><%= players[0].dofus_pseudo %></div>
                        <div class="podium-score"><%= players[0].total_points.toLocaleString() %></div>
                        <div class="champion-tag">CHAMPION OGRE</div>
                    </div>
                    <div class="podium-pedestal">
                        <div class="pedestal-front"></div>
                        <div class="pedestal-top"></div>
                    </div>
                </div>

                <!-- 3rd Place - Right -->
                <div class="podium-item bronze" data-rank="3">
                    <div class="podium-avatar">
                        <span><%= players[2].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <div class="podium-info">
                        <div class="podium-name"><%= players[2].dofus_pseudo %></div>
                        <div class="podium-score"><%= players[2].total_points.toLocaleString() %></div>
                    </div>
                    <div class="podium-pedestal">
                        <div class="pedestal-front"></div>
                        <div class="pedestal-top"></div>
                    </div>
                </div>
            </div>
            <% } %>
        </section>

        <!-- Leaderboard Full Width -->
        <section class="leaderboard-section">
            <div class="table-container">
                <table class="leaderboard-table">
                    <thead>
                        <tr>
                            <th class="col-rank">RANG</th>
                            <th class="col-player">JOUEUR</th>
                            <th class="col-winrate">WINRATE</th>
                            <th class="col-score">SCORE</th>
                        </tr>
                    </thead>
                    <tbody id="leaderboardBody"></tbody>
                </table>
            </div>

            <div id="paginationControls" class="pagination-container"></div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <span>ALLIANCE PVP TRACKER</span>
        <span class="footer-dot"></span>
        <span>Mise à jour : <%= new Date().toLocaleString('fr-FR') %></span>
    </footer>

    <script>
        // 1. INJECTION INITIALE (Données au chargement de la page)
        // Correction du typo 'et' -> 'const'
        let allPlayers = <%- JSON.stringify(players) %>;
        
        // Configuration
        let currentPage = 1;
        const rowsPerPage = 10;
        let filteredPlayers = [...allPlayers]; 
        
        // AUTO-UPDATE : Intervalle en millisecondes (ici 15 secondes)
        const UPDATE_INTERVAL = 15000; 

        const tableBody = document.getElementById('leaderboardBody');
        const paginationDiv = document.getElementById('paginationControls');

        // --- FONCTION : AFFICHER LE TABLEAU ---
        function displayTable() {
            tableBody.innerHTML = "";
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const pageData = filteredPlayers.slice(startIndex, endIndex);

            if (pageData.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:40px; color:rgba(255,255,255,0.3);">Aucun joueur trouvé.</td></tr>`;
                paginationDiv.innerHTML = "";
                return;
            }

            pageData.forEach((player) => {
                // Calculs
                const realRank = allPlayers.indexOf(player) + 1;
                const winrate = player.winrate || 0;
                const wins = player.wins || 0;
                const losses = player.losses || 0;
                
                // Styles CSS dynamiques
                const rowClass = realRank <= 3 ? `top-${realRank}` : '';
                
                let winrateColorClass = 'text-low';
                let winrateFillClass = 'fill-low';
                if (winrate >= 60) { winrateColorClass = 'text-high'; winrateFillClass = 'fill-high'; }
                else if (winrate >= 45) { winrateColorClass = 'text-mid'; winrateFillClass = 'fill-mid'; }

                // HTML Médaille
                let rankHTML = `<span>${realRank}</span>`;
                if (realRank <= 3) rankHTML = `<div class="rank-medal rank-${realRank}">${realRank}</div>`;

                // HTML Rank Change Arrow
                const rankChange = player.rank_change || 0;
                let rankChangeHTML = '';
                if (rankChange > 0) {
                    rankChangeHTML = `<span class="rank-change up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 19V5m-7 7l7-7 7 7"/></svg>${rankChange}</span>`;
                } else if (rankChange < 0) {
                    rankChangeHTML = `<span class="rank-change down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14m7-7l-7 7-7-7"/></svg>${Math.abs(rankChange)}</span>`;
                }

                // Construction de la ligne
                const row = `
                    <tr class="player-row ${rowClass} visible">
                        <td class="cell-rank"><div class="rank-badge">${rankHTML}${rankChangeHTML}</div></td>
                        <td class="cell-player">
                            <div class="player-info">
                                <div class="player-avatar">${player.dofus_pseudo.charAt(0).toUpperCase()}</div>
                                <span class="player-name">${player.dofus_pseudo}</span>
                            </div>
                        </td>
                        <td class="cell-winrate">
                            <div class="winrate-container">
                                <div class="winrate-bar">
                                    <div class="winrate-fill ${winrateFillClass}" style="width: ${winrate}%"></div>
                                </div>
                                <span class="winrate-value ${winrateColorClass}">${winrate}%</span>
                            </div>
                            <span class="winrate-detail">${wins}V / ${losses}D</span>
                        </td>
                        <td class="cell-score">
                            <span class="score-value">${parseInt(player.total_points).toLocaleString()}</span>
                            <span class="score-label">pts</span>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });

            displayPagination();
        }

        // --- FONCTION : PAGINATION ---
        function displayPagination() {
            paginationDiv.innerHTML = "";
            const pageCount = Math.ceil(filteredPlayers.length / rowsPerPage);
            if (pageCount <= 1) return;

            // Bouton Précédent
            const prevBtn = document.createElement('button');
            prevBtn.innerHTML = "&lsaquo;";
            prevBtn.className = "page-btn";
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => { currentPage--; displayTable(); };
            paginationDiv.appendChild(prevBtn);

            // Boutons numérotés intelligents
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(pageCount, currentPage + 2);

            if (startPage > 1) {
                createPageBtn(1);
                if(startPage > 2) paginationDiv.appendChild(document.createTextNode("..."));
            }

            for (let i = startPage; i <= endPage; i++) {
                createPageBtn(i);
            }

            if (endPage < pageCount) {
                if(endPage < pageCount - 1) paginationDiv.appendChild(document.createTextNode("..."));
                createPageBtn(pageCount);
            }

            // Bouton Suivant
            const nextBtn = document.createElement('button');
            nextBtn.innerHTML = "&rsaquo;";
            nextBtn.className = "page-btn";
            nextBtn.disabled = currentPage === pageCount;
            nextBtn.onclick = () => { currentPage++; displayTable(); };
            paginationDiv.appendChild(nextBtn);

            function createPageBtn(i) {
                const btn = document.createElement('button');
                btn.innerText = i;
                btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
                btn.onclick = () => { currentPage = i; displayTable(); };
                paginationDiv.appendChild(btn);
            }
        }

        // --- FONCTION : FILTRER LES DONNÉES (Recherche) ---
        function filterData(resetPage = true) {
            const input = document.getElementById('searchInput').value.toLowerCase();
            // On filtre sur la liste globale 'allPlayers'
            filteredPlayers = allPlayers.filter(p => p.dofus_pseudo.toLowerCase().includes(input));
            
            if (resetPage) currentPage = 1; // On revient page 1 si on tape une recherche
            displayTable();
        }

        // --- 🚀 FONCTION : FETCH DATA (Auto Update) ---
        async function fetchLeaderboardData() {
            try {
                // 1. Quel saison est sélectionnée ?
                const seasonSelect = document.getElementById('seasonSelect');
                const seasonId = seasonSelect ? seasonSelect.value : 1;

                // 2. Appel API
                const response = await fetch(`/api/leaderboard/${seasonId}`);
                if (!response.ok) throw new Error("Erreur réseau");

                const data = await response.json();
                
                // 3. Mise à jour des variables
                allPlayers = data;
                
                // 4. On réapplique le filtre de recherche actuel (sans reset la page si possible)
                // Comme ça si tu es page 2, tu restes page 2
                filterData(false);

                // 5. Mise à jour des stats du Header
                if (document.getElementById('playerCount')) {
                    document.getElementById('playerCount').textContent = data.length;
                }

                // console.log(`🔄 Mise à jour auto effectuée (${new Date().toLocaleTimeString()})`);

            } catch (error) {
                console.error("Erreur Auto-Update:", error);
            }
        }

        // --- INITIALISATION ---
        document.addEventListener('DOMContentLoaded', () => {
            displayTable(); 
            
            // Animation Particules
            const container = document.getElementById('particles');
            if(container) {
                for (let i = 0; i < 25; i++) {
                    const p = document.createElement('div');
                    p.className = 'energy-particle';
                    p.style.cssText = `left:${Math.random()*100}%; --duration:${5+Math.random()*5}s; --delay:${Math.random()*4}s; --size:${3+Math.random()*4}px;`;
                    container.appendChild(p);
                }
            }

            // Animation Podium
            document.querySelectorAll('.podium-item').forEach((item, i) => {
                setTimeout(() => item.classList.add('visible'), 200 + (i * 150));
            });

            // ⏱️ Lancer l'Auto-Update
            setInterval(fetchLeaderboardData, UPDATE_INTERVAL);
        });

        // Events Listeners UI
        const searchInput = document.getElementById('searchInput');
        if(searchInput) searchInput.addEventListener('keyup', () => filterData(true));
        
        const searchToggle = document.getElementById('searchToggle');
        const searchContainer = document.getElementById('searchContainer');
        if(searchToggle && searchContainer) {
            searchToggle.addEventListener('click', () => {
                searchContainer.classList.toggle('expanded');
                if(searchContainer.classList.contains('expanded')) document.getElementById('searchInput').focus();
            });
        }

        // Changement manuel de saison (Déclenche un fetch immédiat)
        const seasonSelect = document.getElementById('seasonSelect');
        if(seasonSelect) {
            seasonSelect.addEventListener('change', fetchLeaderboardData);
        }
    </script>
</body>
</html>
