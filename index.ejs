<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ogre Leaderboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="bg-grid"></div>
    <div class="bg-glow"></div>

    <header>
        <div class="header-content">
            <div class="logo-container">
                <div class="logo">
                    <img src="web/assets/logo_ogre.png" alt="Logo">
                </div>
                <div class="logo-ring"></div>
            </div>
            <h1>Ogre Leaderboard</h1>
            <p class="subtitle">Ranking PVP Ogre</p>
        </div>
        
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon gold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <div class="stat-content">
                    <select id="season-select" class="season-dropdown">
                        <% seasons.slice().reverse().forEach(s => { %>
                            <option value="<%= s.id %>" <%= s.isCurrent ? 'selected' : '' %>>
                                <%= s.label %><%= s.isCurrent ? ' (en cours)' : '' %>
                            </option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <main class="container">
        <section class="podium-section">
            <div class="podium">
                <% if (players[1]) { %>
                <div class="podium-item silver">
                    <div class="podium-rank">2</div>
                    <div class="podium-avatar">
                        <span><%= players[1].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <h3 class="podium-name"><%= players[1].dofus_pseudo %></h3>
                    <div class="podium-score"><%= players[1].total_points.toLocaleString() %></div>
                    <div class="podium-bar">
                        <div class="bar-fill"></div>
                    </div>
                </div>
                <% } %>

                <% if (players[0]) { %>
                <div class="podium-item gold">
                    <div class="crown-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5z"/>
                            <path d="M19 19H5v2h14v-2z"/>
                        </svg>
                    </div>
                    <div class="podium-rank">1</div>
                    <div class="podium-avatar">
                        <span><%= players[0].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <h3 class="podium-name"><%= players[0].dofus_pseudo %></h3>
                    <div class="podium-score"><%= players[0].total_points.toLocaleString() %></div>
                    <div class="podium-bar">
                        <div class="bar-fill"></div>
                    </div>
                </div>
                <% } %>

                <% if (players[2]) { %>
                <div class="podium-item bronze">
                    <div class="podium-rank">3</div>
                    <div class="podium-avatar">
                        <span><%= players[2].dofus_pseudo.charAt(0).toUpperCase() %></span>
                    </div>
                    <h3 class="podium-name"><%= players[2].dofus_pseudo %></h3>
                    <div class="podium-score"><%= players[2].total_points.toLocaleString() %></div>
                    <div class="podium-bar">
                        <div class="bar-fill"></div>
                    </div>
                </div>
                <% } %>
            </div>
        </section>

        <div class="search-wrapper">
            <div class="search-container">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="M21 21l-4.35-4.35"/>
                </svg>
                <input type="text" id="search" placeholder="Rechercher un joueur..." onkeyup="filterTable()">
            </div>
        </div>

        <div class="table-wrapper">
            <table id="leaderboardTable">
                <thead>
                    <tr>
                        <th class="col-rank">Rang</th>
                        <th class="col-player">Joueur / Compte</th>
                        <th class="col-score">Score</th>
                    </tr>
                </thead>
                <tbody>
                    <% players.forEach((player, index) => { %>
                    <tr class="<%= index < 3 ? 'top-' + (index + 1) : '' %>">
                        <td class="cell-rank">
                            <span class="rank-number"><%= index + 1 %></span>
                        </td>
                        <td class="cell-player">
                            <div class="player-avatar">
                                <span><%= player.dofus_pseudo.charAt(0).toUpperCase() %></span>
                            </div>
                            <span class="player-name"><%= player.dofus_pseudo %></span>
                            <% if(index === 0) { %>
                            <span class="leader-badge">Leader</span>
                            <% } %>
                        </td>
                        <td class="cell-score">
                            <span class="score-value"><%= player.total_points.toLocaleString() %></span>
                            <span class="score-label">pts</span>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        // --- 1. FONCTION DE FILTRE (RECHERCHE) ---
        function filterTable() {
            const input = document.getElementById("search");
            const filter = input.value.toLowerCase();
            const rows = document.querySelectorAll("#leaderboardTable tbody tr");
            
            rows.forEach(row => {
                const name = row.querySelector(".player-name").textContent.toLowerCase();
                row.style.display = name.includes(filter) ? "" : "none";
            });
        }

        // --- 2. GESTION DU CHANGEMENT DE SAISON ---
        const seasonSelect = document.getElementById('season-select');
        if (seasonSelect) {
            seasonSelect.addEventListener('change', async function() {
                const seasonId = this.value;
                try {
                    const response = await fetch(`/api/leaderboard/${seasonId}`);
                    const players = await response.json();
                    updatePodium(players);
                    updateTable(players);
                } catch (error) {
                    console.error('Erreur chargement saison:', error);
                }
            });
        }

        function updatePodium(players) {
            const podium = document.querySelector('.podium');
            const positions = ['silver', 'gold', 'bronze'];
            const indices = [1, 0, 2];
            
            indices.forEach((playerIdx, i) => {
                const item = podium.querySelector(`.podium-item.${positions[i]}`);
                // Attention: players[playerIdx] peut être undefined si < 3 joueurs
                if (players[playerIdx]) {
                    item.style.display = ''; // Rendre visible
                    // Mise à jour Avatar (première lettre)
                    const avatarSpan = item.querySelector('.podium-avatar span');
                    if(avatarSpan) avatarSpan.textContent = players[playerIdx].dofus_pseudo.charAt(0).toUpperCase();
                    
                    // Mise à jour Nom
                    const nameDiv = item.querySelector('.podium-name');
                    if(nameDiv) nameDiv.textContent = players[playerIdx].dofus_pseudo;
                    
                    // Mise à jour Score
                    const scoreDiv = item.querySelector('.podium-score');
                    if(scoreDiv) scoreDiv.textContent = players[playerIdx].total_points.toLocaleString();
                } else if (item) {
                    item.style.display = 'none'; // Cacher si pas de joueur
                }
            });
        }

        function updateTable(players) {
            const tbody = document.querySelector('#leaderboardTable tbody');
            tbody.innerHTML = players.map((player, index) => `
                <tr class="${index < 3 ? 'top-' + (index + 1) : ''}">
                    <td class="cell-rank">
                        <span class="rank-number">${index + 1}</span>
                    </td>
                    <td class="cell-player">
                        <div class="player-avatar">
                            <span>${player.dofus_pseudo.charAt(0).toUpperCase()}</span>
                        </div>
                        <span class="player-name">${player.dofus_pseudo}</span>
                        ${index === 0 ? '<span class="leader-badge">Leader</span>' : ''}
                    </td>
                    <td class="cell-score">
                        <span class="score-value">${player.total_points.toLocaleString()}</span>
                        <span class="score-label">pts</span>
                    </td>
                </tr>
            `).join('');
        }

        // --- 3. ANIMATION AU CHARGEMENT ---
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.podium-item, .table-wrapper tr').forEach(el => {
                observer.observe(el);
            });
        });
    </script>
</body>
</html>